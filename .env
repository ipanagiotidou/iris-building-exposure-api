
"""
Actual local values and secrets.
"""

# Path ------------------------------------------------------------------------------------------------------------------------
PYTHONPATH=scripts/   # might not need it 

# DATABASE
#   keep DB credentials here - used in docker-compose.yml and in scripts/config.py
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST = localhost  # the hostname of the PostgreSQL database server. Set to localhost, which means the database is running on the same machine as the application.
POSTGRES_PORT = 5433  # the port on which the PostgreSQL database will be exposed to the host machine.
POSTGRES_DB=building_exposure

# EXTERNAL SERVICES
PDOK_BAG_BASE_URL=https://api.pdok.nl/kadaster/bag/ogc/v2
STAC_SEARCH_URL=https://stac.asf.alaska.edu/search

# API KEYS
# OPENTOPOGRAPHY_API_KEY = 

# STORAGE (relative paths)
RAW_DATA_DIR=data/raw        
OUTPUT_DATA_DIR=data/output  

# CACHE 
CACHE_NAME=http_cache


